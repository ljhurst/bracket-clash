{
  "name": "bracket-clash",
  "version": "1.4.0",
  "description": "Combine men's and women's bracket scores",
  "type": "module",
  "private": true,
  "directories": {
    "test": "test"
  },
  "scripts": {
    "format": "prettier --write 'index.html' 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "npm run format -- --check",
    "lint": "eslint src/ test/",
    "lint:fix": "npm run lint -- --fix",
    "lint:css": "stylelint 'assets/css/**/*.css'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "webpack --mode production",
    "build:watch": "npm run build -- --watch",
    "release": "npm run format && npm run lint && npm run lint:css && npm run test && npm run build"
  },
  "author": "Luke Hurst <hurstlj@umich.edu>",
  "license": "MIT",
  "devDependencies": {
    "@types/chart.js": "^4.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@types/datatables.net": "^1.10.28",
    "@types/datatables.net-fixedcolumns": "^3.3.4",
    "chart.js": "^4.5.1",
    "datatables.net": "^3.1.4",
    "datatables.net-dt": "^3.1.4",
    "datatables.net-fixedcolumns": "^6.1.1"
  }
}
